# Copie este archivo como .env y complete los valores. El archivo .env no se sube al repositorio.

# Frase secreta para anonimizar las cédulas (hash SHA-256). Use la misma en todas las corridas
# para que el identificador de cada cliente sea estable entre cargas.
HASH_SALT=

# Destino de la carga (SQLAlchemy). Si se deja vacío se usa SQLite en data/warehouse/.
# Ejemplo PostgreSQL: postgresql+psycopg2://etl_user:clave@localhost:5432/drogueria
DB_URL=
